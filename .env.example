# ---- Server ----
NODE_ENV=development
PORT=4000
# all | api | worker  (api/worker split requires DATABASE_URL, see docs/DECISIONS.md ADR-002)
SERVER_ROLE=all
# Public origin of the web UI (used for CSRF origin check and OAuth redirects)
APP_ORIGIN=http://localhost:3000

# ---- Database ----
# Leave empty to use embedded PGlite under .data/pglite
DATABASE_URL=

# ---- Security ----
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ORCH_ENCRYPTION_KEY=
SESSION_TTL_HOURS=168
# Only honoured when NODE_ENV != production
ALLOW_DEV_LOGIN=true

# ---- GitHub OAuth app ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Token used by the orchestrator for repository operations (fine-grained PAT or GitHub App token)
GITHUB_TOKEN=

# ---- Model providers (all optional; configure more in Settings → Models) ----
# With no provider key configured, the deterministic mock provider is used (demo mode, zero cost).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Any OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, OpenRouter, Mistral, DeepSeek, Groq ...)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# ---- Budgets ----
GLOBAL_DAILY_BUDGET_USD=25

# ---- Sandbox ----
# docker | none   (none → verification is delegated to CI)
SANDBOX=none
# Docker network with egress restricted to a package-registry proxy; required for dependency installs in the sandbox
SANDBOX_EGRESS_NETWORK=

# ---- Workers & demo ----
WORKER_CONCURRENCY=2
SCHEDULER_INTERVAL_MS=15000
# Artificial latency of mock agents in demo mode (ms), so pipelines are visible in the dashboard
DEMO_LATENCY_MS=600

# ---- Web dashboard ----
# Where the Next.js app proxies /api requests
ORCH_SERVER_URL=http://127.0.0.1:4000
